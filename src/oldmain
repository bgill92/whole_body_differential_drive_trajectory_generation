        rec.log_static(path.clone(), &rerun::CoordinateFrame::new(link))?;
        rec.log_static(path, &rerun::TransformAxes3D::new(0.1))?;
    }

    // 1. Define where "goal_frame" sits, relative to an existing frame.
    rec.log_static(
        "goal_transform",
        &rerun::Transform3D::new()
            .with_translation([-1.0, -1.0, 1.0])
            .with_rotation_axis_angle(rerun::RotationAxisAngle::new(
                [1.0, 0.0, 0.0],
                rerun::Angle::from_radians(PI),
            ))
            .with_parent_frame("world") // must match a real URDF frame
            .with_child_frame("goal_frame"),
    )?;

    // 2. Draw axes at that frame — identical to the link loop.
    rec.log_static("axes/goal", &rerun::CoordinateFrame::new("goal_frame"))?;
    rec.log_static("axes/goal", &rerun::TransformAxes3D::new(0.1))?;

    let target_link = serial_chain.find("root").unwrap();
    serial_chain.update_transforms();
    let mut target = target_link.world_transform().unwrap();
    target.translation.vector.x += -1.0;
    target.translation.vector.y += -1.0;
    target.translation.vector.z += 1.0;

    // target.rotation.vector.i = 1.0;
    // target.rotation.vector.j = 0.0;
    // target.rotation.vector.k = 0.0;
    // target.rotation.vector.w = 0.0;

    target.rotation =
        k::nalgebra::UnitQuaternion::from_axis_angle(&k::nalgebra::Vector3::x_axis(), PI.into());

    let solver = k::JacobianIkSolver::new(0.01, 0.01, 0.5, 100);

    println!("initial angles={:?}", chain.joint_positions());

    solver.solve(&serial_chain, &target).unwrap();

    println!("solved angles={:?}", chain.joint_positions());

    let names: Vec<String> = serial_chain.iter_joints().map(|j| j.name.clone()).collect();
    let positions = serial_chain.joint_positions();

    rec.set_time_sequence("step", 0);
    for (name, position) in names.iter().zip(&positions) {
        let joint = urdf
            .get_joint_by_name(name)
            .ok_or_else(|| format!("no urdf joint named {name}"))?;
        let joint_transform = urdf.compute_joint_transform(joint, *position, false)?;
        rec.log("/transforms", &joint_transform)?;
    }

