use rerun::external::re_importer::UrdfTree;
use rerun::{CoordinateFrame, TransformAxes3D};

use rerun::external::{anyhow, re_log, urdf_rs};

fn main() -> Result<(), Box<dyn std::error::Error>> {
    re_log::setup_logging();

    let rec = rerun::RecordingStreamBuilder::new("urdf_view").spawn()?;

    let urdf_path = "assets/rox_diff_ur5e.urdf";

    rec.log_file_from_path(urdf_path, None, true)?;

    let urdf = UrdfTree::from_file_path(urdf_path, None)?;

    println!("Joints:");
    for joint in urdf.joints() {
        println!("name: {}, type: {:?}", joint.name, joint.joint_type);
        if joint.name == "ur5eshoulder_pan_joint" {
            let joint_transform = urdf.compute_joint_transform(joint, 3.14159, true)?;
            rec.log("/transforms", &joint_transform)?;
        }
    }

    let mut links: Vec<&str> = vec![urdf.root().name.as_str()];
    links.extend(urdf.joints().map(|j| j.child.link.as_str()));

    // println!("Links:");
    // for link in links {
    //     println!("{}", link);
    // }

    for link in links {
        let path = format!("axes/{}", link);
        rec.log_static(path.clone(), &rerun::CoordinateFrame::new(link))?;
        rec.log_static(path, &rerun::TransformAxes3D::new(0.1))?;
    }

    // println!("{}", urdf.root().name);

    // rec.log("world", );

    for step in 0..10000 {
        rec.set_time_sequence("step", step);
        // println!("Step {}", step);

        let x = step as f64;

        let x = (x / 25.0).sin();
        let joint = urdf
            .get_joint_by_name("world_base_link_planar_prismatic_x")
            .unwrap();

        let joint_transform = urdf.compute_joint_transform(joint, x, false)?;

        rec.log("/transforms", &joint_transform)?;
    }

    // // Animate:
    // for step in 0..10000 {
    //     rec.set_time_sequence("step", step);
    //     for (joint_index, joint) in urdf.joints().enumerate() {
    //         if joint.joint_type == urdf_rs::JointType::Revolute {
    //             // Usually this angle would come from a measurement - here we just fake something:
    //             let dynamic_angle = emath::remap(
    //                 (step as f64 * (0.02 + joint_index as f64 / 100.0)).sin(),
    //                 -1.0..=1.0,
    //                 joint.limit.lower..=joint.limit.upper,
    //             );

    //             // Rerun loads the URDF transforms with child/parent frame relations.
    //             // In order to move a joint, we just need to log a new transform between two of those frames.
    //             //
    //             // `compute_joint_transform` handles origin + axis-angle rotation and sets the
